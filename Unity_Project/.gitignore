# ==========================================
# 1. Unity 忽略清單 (避免 GitHub 爆掉的關鍵)
# ==========================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uilds/
[Bb]uild/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# 忽略 Unity 自動生成的專案檔 (換電腦時會自動重新生成)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 忽略作業系統產生的垃圾檔
.DS_Store
Thumbs.db

# ==========================================
# 2. Python 忽略清單 (保持視覺環境乾淨)
# ==========================================
# 忽略快取
__pycache__/
*.py[cod]
*$py.class

# 忽略虛擬環境 (如果你有用的話)
venv/
env/
.env

# ==========================================
# 3. 專案專屬設定 (不要把測試照片傳上去)
# ==========================================
Python_CV/calibration_images/
*.mp4
*.avi
# (如果你未來有 YOLO 權重檔，可以把 *.pt 加進來)